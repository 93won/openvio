Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Tree Height: 300
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Color: 110; 110; 115
      Reference Frame: world
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 0.6
      Show Arrows: false
      Show Axes: true
      Show Names: true
    - Class: rviz_default_plugins/Path
      Name: Trajectory
      Enabled: true
      Color: 64; 160; 255
      Line Style: Billboards
      Line Width: 0.04
      Buffer Length: 1
      Topic:
        Value: /path
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PointCloud2
      Name: Landmarks
      Enabled: true
      Style: Spheres
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 255; 150; 40
      Decay Time: 0
      Topic:
        Value: /landmarks
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Image
      Name: Tracked features
      Enabled: true
      Topic:
        Value: /tracked_image
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
  Global Options:
    Fixed Frame: world
    Background Color: 30; 32; 36
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Follow the IMU
      Target Frame: imu
      Distance: 8
      Pitch: 0.75
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
Window Geometry:
  Width: 1600
  Height: 950
  Tracked features:
    collapsed: false
