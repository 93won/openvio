<?xml version="1.0"?>
<package format="2">
  <name>openvio_ros1</name>
  <version>1.0.1</version>
  <description>ROS 1 node of OpenVIO, a visual-inertial odometry for a wide range of camera models</description>
  <maintainer email="csw3575@snu.ac.kr">Seungwon Choi</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <build_depend>libopencv-dev</build_depend>
  <build_depend>libpng-dev</build_depend>

  <exec_depend>rviz</exec_depend>
</package>
